}

@article{jose2024smart,
  author    = {Jose, John Anthony C. and Bertumen, Christopher John B. and Roque, Marianne Therese C. and Umali, Allan Emmanuel B. and Villanueva, Jillian Clara T. and TanAi, Richard Josiah and Sybingco, Edwin and San Juan, Jayne and Gonzales, Erwin Carlo},
