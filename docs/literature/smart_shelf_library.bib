@article{falcao2020faim,
  author    = {Falc{\~a}o, Jo{\~a}o and Ruiz, Carlos and Pan, Shijia and Noh, Hae Young and Zhang, Pei},
  title     = {FAIM: Vision and Weight Sensing Fusion Framework for Autonomous Inventory Monitoring in Convenience Stores},
  journal   = {Frontiers in Built Environment},
  volume    = {6},
  pages     = {568372},
  year      = {2020},
  publisher = {Frontiers Media SA},
  doi       = {10.3389/fbuil.2020.568372},
  url       = {https://doi.org/10.3389/fbuil.2020.568372},
  keywords  = {smart retail, sensor fusion, computer vision, weight sensors, load cell, inventory monitoring},
  file      = {C\:\\Users\\ADMIN\\Documents\\Disagreement-Aware Vision and Weight Sensor Fusion for AIoT Smart Shelf Inventory Monitoring\\References\\faim-vision-and-weight-sensing-fusion-framework-for-2p6o3s5jz5.pdf:application/pdf},
